classDiagram
    class Library {
        +add_book(book)
        +register_user(user)
        +create_loan(book, user)
    }
    class User {
        -string name
        -string email
    }
    class Book {
        -string title
        -string author
        -bool state
        +mark_as_unavailable()
        +mark_as_available()
    }
    class Loan {
        -date start_date
        -date end_date
        +close_loan()
    }
    Library "1" *-- "0..*" User
    Library "1" *-- "0..*" Book
    Library "1" *-- "0..*" Loan
    Loan "0..*" --> "1" User
    Loan "0..*" --> "1" Book